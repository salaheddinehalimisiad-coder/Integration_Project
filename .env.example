# Configuration de l'environnement DataMediator Pro

# Mode de base de données
USE_DOCKER=true

# Configuration API
API_HOST=0.0.0.0
API_PORT=5001
API_RELOAD=true

# Configuration CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Configuration base de données PostgreSQL (si USE_DOCKER=true)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=datamediator
POSTGRES_PASSWORD=datamediator123
POSTGRES_DB=hr_db

# Configuration base de données MySQL (si USE_DOCKER=true)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=datamediator
MYSQL_PASSWORD=datamediator123
MYSQL_DB=projects_db

# Configuration MongoDB (si USE_DOCKER=true)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=datamediator
MONGO_PASSWORD=datamediator123
MONGO_DB=finance_db

# Configuration JWT
JWT_SECRET_KEY=votre-secret-key-tres-securise-ici
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Configuration logging
LOG_LEVEL=INFO
LOG_FILE=logs/datamediator.log

# Taux de conversion
EUR_TO_USD=1.08
DZD_TO_USD=0.0074
